.container {padding: 20rpx;
  padding: 20rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.bike-item {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.bike-pic {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  display: block;
  background: #f0f0f0;
}

.bike-info {
    display: flex;
    flex-direction: column;
    margin-top: 16rpx;
}

.bike-name {
    font-size: 34rpx;
    font-weight: bold;
    display: block;
}

.bike-price {
    font-size: 30rpx;
    margin-top: 8rpx;
    display: block;
}