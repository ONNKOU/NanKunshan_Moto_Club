.container { padding: 40rpx; }

.user-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 0;
    background: #fff;
    border-radius: 16rpx;
    margin-bottom: 40rpx;
}

.avatar-btn {
    padding: 0;
    background: none;
    border: none;
    line-height: 1;
    margin-bottom: 20rpx;
}

.avatar-btn::after { border: none; }

.avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    background: #eee;
}

.nickname {
    font-size: 32rpx;
    font-weight: bold;
    text-align: center;
}

.menu {
    background: #fff;
    border-radius: 16rpx;
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    font-size: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.arrow { color: #ccc; }